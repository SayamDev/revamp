# Relay configuration. Every value here is optional — with no .env file at all
# the app runs in demo mode, which is the intended default.
#
# Copy to .env.development.local for local development. Both that file and
# .env.local are gitignored; use the .development. form for anything that
# points at your own machine, so a production build never inherits it.

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
# demo   — deterministic rules engine (default, no dependencies, no cost)
# ollama — a local model through Ollama, with automatic fallback to demo rules
VITE_AI_PROVIDER=demo

# Only used when VITE_AI_PROVIDER=ollama
VITE_OLLAMA_HOST=http://localhost:11434
VITE_OLLAMA_MODEL=llama3.2

# ---------------------------------------------------------------------------
# Automation adapter
# ---------------------------------------------------------------------------
# demo — in-process workflow engine (default)
# n8n  — POST the trigger to a local n8n webhook; falls back to demo if it is
#        unreachable or the run fails. See n8n/README.md.
VITE_AUTOMATION_ADAPTER=demo
VITE_N8N_WEBHOOK_URL=http://localhost:5678/webhook/relay-enquiry

# ---------------------------------------------------------------------------
# There are deliberately no API keys, tokens or database URLs in this project.
# Relay holds no personal data and calls no paid service.
# ---------------------------------------------------------------------------
